# Geant4 Simulation Dashboard - Docker Environment
# Copy to .env and configure before running

# Cloudflare Tunnel Token (required for external access)
# Get from: https://one.dash.cloudflare.com/ → Zero Trust → Networks → Tunnels
TUNNEL_TOKEN=

# Domain configuration
DOMAIN_WEB=sim.maksu.online
DOMAIN_API=api.maksu.online

# Optional: Additional CORS origins (comma-separated)
# CORS_ORIGINS=https://example.com
